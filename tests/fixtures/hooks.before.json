{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /usr/bin/pre-existing-user-prompt.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"C:/Old Python/python.exe\" \"C:/legacy/orchestrator_user_prompt.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python /usr/bin/pre-existing-pre-tool.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "C:\\\\LegacyPython\\\\python.exe C:\\\\legacy\\\\orchestrator_pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
